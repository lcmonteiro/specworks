direction: right

cli: cli (src/specworks/cli) {
  commands: "changes.py, workflow.py (new, phase, start, gate, run, finding, cycle, validate, commit, close, abandon)"
  telemetry: telemetry.py {
    tooltip: "record, telemetry_state, telemetry_ids, send_after_commit, telemetry push"
  }
  project_cmds: "project.py (context)"
  output: "output.py (status: telemetry IDs)"
  harness_cmd: "harness.py (harness, lazy import)"
  login_cmd: "login.py (login, lazy import)"

  commands -> telemetry: event name, fields, start time
  project_cmds -> telemetry: telemetry state
  output -> telemetry: trace and session IDs
}

project: project.events
integrations: integrations.langfuse
harness: "harness (optional extra)"

cli.telemetry -> project: record event, trace ID
cli.telemetry -> integrations: settings, send unsent events
cli.harness_cmd -> harness: "request, change (imported only when run)"
cli.login_cmd -> harness: "scope, project root, flags in; result out (imported only when run)"
cli.login_cmd -> project: "workspace root (--local)"
