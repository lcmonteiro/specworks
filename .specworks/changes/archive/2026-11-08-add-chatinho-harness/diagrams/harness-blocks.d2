direction: right

harness: harness (src/specworks/harness) {
  session: "session.py (build_harness, run_harness, first_peer)"
  peers: "peers.py (SkillPeer x 15, preamble)"
  workspaces: "workspaces.py (SpecworksWorktrees, SpecworksWorkspace.run, /merge)"
  confine: "confine.py (push refused, shell environment)"
  backend: "backend.py (GitBackend)"
  model: "model.py (model_from_env)"

  session -> peers: one per skill
  session -> backend: run's change
  session -> workspaces: provider, /merge
  session -> model: chat model
  workspaces -> confine: refuses, shell_env
}

chatinho: "chatinho (ChatSession, DeepAgentConnector, GitWorktrees, /ws, terminal)"
integrations: "integrations (read_skill)"
workflow: "workflow (merge_branch)"
project: "project (Workspace, Change, ensure_ignored)"
repo: git repository {
  shape: cylinder
}
env: "SPECWORKS_MODEL_* environment" {
  shape: page
}

harness.session -> chatinho: session, /ws, terminal
harness.peers -> chatinho: DeepAgentConnector
harness.workspaces -> chatinho: GitWorktrees, Workspace
harness.peers -> integrations: skill text
harness.workspaces -> workflow: merge peer/test
harness.workspaces -> repo: "checkout, peer/test worktree"
harness.backend -> project: change folder, .gitignore
harness.backend -> repo: chat.jsonl
harness.model -> env: key, model, base URL
